{
  "manifest_version": 3,
  "name": "Loophole for Iterable",
  "short_name": "Loophole",
  "version": "0.0.0",
  "description": "Power tools for Iterable: bulk data, template and profile helpers, and more. Community-built; not affiliated with Iterable.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://app.iterable.com/*",
    "https://app.eu.iterable.com/*",
    "https://api.iterable.com/*",
    "https://api.eu.iterable.com/*",
    "https://app.getbee.io/*"
  ],
  "optional_host_permissions": ["https://auth.iterable.com/*"],
  "optional_permissions": ["notifications"],
  "action": {
    "default_title": "Loophole for Iterable",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "copy-approval-screenshot": {
      "suggested_key": { "default": "Alt+Shift+K", "mac": "MacCtrl+Shift+K" },
      "description": "Copy approval screenshot"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://app.iterable.com/*", "https://app.eu.iterable.com/*"],
      "js": ["main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.iterable.com/*", "https://app.eu.iterable.com/*"],
      "js": ["content-app.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.getbee.io/*"],
      "js": ["content-bee.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["https://app.iterable.com/*", "https://app.eu.iterable.com/*", "https://app.getbee.io/*"]
    }
  ]
}
